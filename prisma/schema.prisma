generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Content {
  id          String          @id @default(cuid())
  title       String
  description String          @db.Text
  imageUrl    String          @default("")
  category    String
  kind        String
  tags        String[]        @default([])
  status      String          @default("Draft")
  featured    Boolean         @default(false)
  year        String?
  duration    String?
  sortOrder   Int             @default(0)
  language    String          @default("")
  country     String          @default("")
  ageRating   String          @default("")
  parentId    String?
  parent      Content?        @relation("ContentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Content[]       @relation("ContentHierarchy")
  sources     ContentSource[]
  captions    CaptionTrack[]
  reactions   ContentReaction[]
  comments    ContentComment[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status, category])
  @@index([featured, sortOrder])
  @@index([title])
  @@index([parentId])
  @@index([kind])
}

model ContentSource {
  id           String   @id @default(cuid())
  contentId    String
  content      Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  provider     String
  url          String   @db.Text
  label        String   @default("")
  isPrimary    Boolean  @default(false)
  playbackMode String   @default("auto")
  createdAt    DateTime @default(now())

  @@index([contentId])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

model Genre {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model CaptionTrack {
  id          String   @id @default(cuid())
  contentId   String
  content     Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  language    String   @default("en")
  label       String   @default("English")
  isDefault   Boolean  @default(false)
  format      String   @default("vtt")
  contentText String   @db.Text
  createdAt   DateTime @default(now())

  @@index([contentId])
}


model ContentReaction {
  id        String   @id @default(cuid())
  contentId String
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  voterKey  String
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contentId, voterKey])
  @@index([contentId, value])
}

model ContentComment {
  id        String   @id @default(cuid())
  contentId String
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  author    String   @default("Guest")
  voterKey  String
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([contentId, createdAt])
}
